# Copy to .env and adjust. Never commit real values.

# Backend
DATABASE_URL=jdbc:postgresql://localhost:55432/exorcity
DB_USERNAME=exorcity
DB_PASSWORD=exorcity
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRATION_MINUTES=720
CORS_ALLOWED_ORIGINS=http://localhost:4200
PORT=8080
# Optional: enables real photo uploads (format: cloudinary://<api_key>:<api_secret>@<cloud_name>)
CLOUDINARY_URL=
